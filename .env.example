# Copy this file to .env.local (or add these in Vercel -> Settings -> Environment Variables)
# Both values are in Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Your website address, used for the QR code and sharing links.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.pk

# Video call server. meet.jit.si is free; calls open in a new tab.
# With your own Jitsi server or 8x8 JaaS, set the URL here and VIDEO_EMBED=true to show calls inside the site.
NEXT_PUBLIC_VIDEO_BASE_URL=https://meet.jit.si
NEXT_PUBLIC_VIDEO_EMBED=false
